Dialogue: 0,0:00:01.01,0:00:03.00,Main,Taichi,0000,0000,0000,,Hey, are you listening?!
Dialogue: 0,0:00:03.66,0:00:07.44,Main,Taichi,0000,0000,0000,,I told you! The auto-locking \Ndoor was left wide open!
Dialogue: 0,0:00:07.89,0:00:09.68,Main,Taichi,0000,0000,0000,,Don't make me repeat myself!
Dialogue: 0,0:00:10.44,0:00:12.47,Main,Screen,0000,0000,0000,,{\pos(592,80)\an8\fs18\bord0\shad0}Operating Pro
Dialogue: 0,0:00:10.44,0:00:12.47,Main,Screen,0000,0000,0000,,{\pos(592,130)\an8\fs10\bord0\shad0}1) Please\Nthe room you wish to visit.
Dialogue: 0,0:00:10.44,0:00:12.47,Main,Screen,0000,0000,0000,,{\pos(592,194)\an8\fs10\bord0\shad0}2) Please\Nconfirm on the display.
Dialogue: 0,0:00:10.44,0:00:12.47,Main,Screen,0000,0000,0000,,{\pos(592,250)\an8\fs10\bord0\shad0}3) Please\Nthe room you're visiting.
Dialogue: 0,0:00:10.83,0:00:12.47,Main,Taichi,0000,0000,0000,,I told you this last week, too!
Dialogue: 0,0:00:13.30,0:00:16.07,Main,Taichi,0000,0000,0000,,Why am I paying such \Nhigh management fees?!
Dialogue: 0,0:00:16.94,0:00:18.00,Main,Taichi,0000,0000,0000,,Huh?!
Dialogue: 0,0:00:18.00,0:00:19.38,Main,Taichi,0000,0000,0000,,Screw you!
Dialogue: 0,0:00:19.38,0:00:20.45,Main,Taichi,0000,0000,0000,,Do it today!
Dialogue: 0,0:00:20.45,0:00:22.64,Main,Taichi,0000,0000,0000,,Come inspect it right now!
Dialogue: 0,0:00:23.48,0:00:25.29,Main,Taichi,0000,0000,0000,,Are you even listening to me?!
Dialogue: 0,0:00:25.81,0:00:27.44,Main,Taichi,0000,0000,0000,,I'll kill you!
Dialogue: 0,0:01:51.11,0:01:54.86,Show_Title,,0000,0000,0000,,{\fad(1398,1)\c&H0F0D09&\3c&HB7BD80&\t(1236,1817,1 \3c&H85A2A4&)\t(1819,2945,1 \3c&H95DED9&)}JUJUTSU KAISEN
